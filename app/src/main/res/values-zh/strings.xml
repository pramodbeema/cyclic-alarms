    <!-- Release Notes Items v1.6.5 -->
    <string name="rel_v1_6_5_item1">单次闹钟问题修复 — 单次闹钟在响铃并关闭后将自动关闭，防止出现非预期的每日重复响铃</string>

    <!-- Release Notes Items v1.6.4 -->
    <string name="rel_v1_6_4_item1">全离线深度本地化 — 所有页面、标签页、弹窗、计时器、秒表、设置、更新历史及响铃界面全面支持 11 种语言</string>
    <string name="rel_v1_6_4_item2">首次启动优先语言选择 — 在系统权限请求前立即弹出语言与主题配置向导</string>
    <string name="rel_v1_6_4_item3">统一标准数字显示 — 数字在所有语言下均严格保持 1, 2, 3 格式，确保极佳阅读体验</string>

    <!-- Release Notes Items v1.6.3 -->
    <string name="rel_v1_6_3_item1">多语言国际化基础 — 新增应用内语言选择器与 11 种离线语言包</string>
    <string name="rel_v1_6_3_item2">初次启动引导 — 安装后即可直接选择偏好语言与主题配色</string>
    <string name="rel_v1_6_3_item3">应用内语言设置 — 可在“设置”页面随时快捷切换显示语言</string>

    <!-- Release Notes Items v1.6.2 -->
    <string name="rel_v1_6_2_item1">Android 9 兼容性修复 — 彻底解决 Android 9 及低版本系统上的闪退问题</string>
    <string name="rel_v1_6_2_item2">后台服务稳定性守护 — 前台服务通知机制加固，确保计时准确无误</string>
    <string name="rel_v1_6_2_item3">计时器警报即时静音 — 点击清除或重置立即停止提示音播放</string>
    <string name="rel_v1_6_2_item4">智能通知交互导航 — 通知标题实时区分计时器与秒表，点击直达对应标签页</string>
    <string name="rel_v1_6_2_item5">纯净闹钟生命周期 — 闹钟关闭后立即恢复锁屏状态，无后台泄露</string>

    <!-- Release Notes Items v1.6.1 -->
    <string name="rel_v1_6_1_item1">F-Droid 规范合规 — 纯净开源元数据，Apache-2.0 协议，移除网络检查器</string>
    <string name="rel_v1_6_1_item2">权限管理精简体验 — 适配现代及早期 Android 的极简权限申请流程</string>

    <!-- Release Notes Items v1.6 -->
    <string name="rel_v1_6_item1">常驻后台通知保护 — 计时器运行时通知不可滑动清除，附带“全部停止”快捷操作</string>
    <string name="rel_v1_6_item2">浅色模式时间对比度修复 — 闹钟时间采用深色高对比度色彩，阅读更清晰</string>
    <string name="rel_v1_6_item3">浅色背景色调优化 — 采用微蓝灰底色，使白色亮度滑块调节更加灵敏自然</string>

    <!-- Release Notes Items v1.5 -->
    <string name="rel_v1_5_item1">自定义铃声记忆 — 新建闹钟自动沿用上次选取的自定义音频文件</string>
    <string name="rel_v1_5_item2">多计时器并行 — 支持同时运行多达 5 个独立的倒计时器</string>
    <string name="rel_v1_5_item3">Pure Dark 纯黑模式 — 采用纯黑 AMOLED 配色，为 OLED 屏幕极致省电</string>
    <string name="rel_v1_5_item4">浅色模式亮度滑块 — 自由调节背景从微调灰到纯白底色</string>
    <string name="rel_v1_5_item5">后台计时器与秒表 — 依靠前台服务切入后台依然精准计时</string>
    <string name="rel_v1_5_item6">静音与勿扰穿透响铃 — 闹钟自动绕过系统静音设置，杜绝错过重要日程</string>

    <!-- Release Notes Items v1.4 -->
    <string name="rel_v1_4_item1">官方包名重塑 — 包名全新规范为 com.beemasfincon.cyclicalarms</string>
    <string name="rel_v1_4_item2">稳定性全方位提升 — 优化闹钟定时与服务生命周期调度机制</string>

    <!-- Release Notes Items v1.3 -->
    <string name="rel_v1_3_item1">倒计时器 — 环形进度显示、常用预设（1至30分钟）以及震动声音提示</string>
    <string name="rel_v1_3_item2">精准秒表 — 计圈记录、极值圈数高亮标记以及触摸音效反馈</string>
    <string name="rel_v1_3_item3">锁屏严格隐私模式 — 仅在响铃瞬间置顶，关闭后立即锁屏恢复</string>
    <string name="rel_v1_3_item4">4 标签页结构导航 — 闹钟、计时器、秒表、以及内嵌关于页的设置</string>
    <string name="rel_v1_3_item5">默认循环周期标签 — 新建闹钟默认首选“循环天数”模式</string>
    <string name="rel_v1_3_item6">图标完美居中 — 桌面启动器图标不再被裁切变形</string>

    <!-- Release Notes Items v1.2 -->
    <string name="rel_v1_2_item1">螺旋素描图标 — 对称优雅的手绘铅笔素描闹钟启动图标</string>
    <string name="rel_v1_2_item2">独立贪睡时长设定 — 可为每个闹钟个性化指定贪睡提醒间隔</string>
    <string name="rel_v1_2_item3">系统锁屏原生响铃 — 无需解锁输入 PIN 码即可平稳覆盖响铃</string>
    <string name="rel_v1_2_item4">独立页面导航 — 干净清晰的 4 栏分类排版</string>
    <string name="rel_v1_2_item5">12/24 小时制自由切换 — 支持大写 AM/PM 或标准 24 小时制</string>
    <string name="rel_v1_2_item6">主界面日期完整年份 — 首页时钟显示完整年份（例如：2026年9月5日 周六）</string>
    <string name="rel_v1_2_item7">首启主题感知提示 — 确保状态栏图标在亮暗背景下均清晰可见</string>
    <string name="rel_v1_2_item8">应用内权限管理中心 — 一键查验与开启通知、精确闹钟及悬浮窗权限</string>
    <string name="rel_v1_2_item9">支持与社区卡片 — 便捷反馈意见和提交缺陷报告</string>

    <!-- Release Notes Items v1.1 -->
    <string name="rel_v1_1_item1">深色 / 浅色 / 跟随系统主题切换</string>
    <string name="rel_v1_1_item2">闹钟编辑器默认定位当前系统时间</string>
    <string name="rel_v1_1_item3">分钟微调轮盘持久可见</string>
    <string name="rel_v1_1_item4">新增高频清脆铃声 — 响亮清晰的双音调提示</string>
    <string name="rel_v1_1_item5">新闹钟音量默认设为最大音量</string>
    <string name="rel_v1_1_item6">主界面印刻 Beema\'s FINCON 专属标志</string>

    <!-- Release Notes Items v1.0 -->
    <string name="rel_v1_0_item1">循环闹钟 — 从基准日起每隔 N 天规律响铃</string>
    <string name="rel_v1_0_item2">周闹钟 — 支持自由勾选一周内的任意几天</string>
    <string name="rel_v1_0_item3">7 款内置合成铃声，支持自定义本地音频</string>
    <string name="rel_v1_0_item4">可配置贪睡时长与震动开关</string>
    <string name="rel_v1_0_item5">闹钟历史记录与一键清除功能</string>
</resources>

