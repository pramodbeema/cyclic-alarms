    <!-- Release Notes Items v1.7 -->
    <string name="rel_v1_7_item1">Live-Schlummerbenachrichtigung — Live-Countdown der verbleibenden Zeit, Schlummerzeitpunkt und Dauer mit Direkt-Verwerfen</string>
    <string name="rel_v1_7_item2">Erweiterter Weckbildschirm — Vollbildanzeige zeigt aktuelle Uhrzeit und genauen Schlummerzeitpunkt</string>

    <!-- Release Notes Items v1.6.5 -->
    <string name="rel_v1_6_5_item1">Korrektur für einmalige Wecker — einmalige Wecker deaktivieren sich nun nach dem Klingeln und Ausschalten automatisch, wodurch unerwünschtes tägliches Klingeln verhindert wird</string>

    <!-- Release Notes Items v1.6.4 -->
    <string name="rel_v1_6_4_item1">Vollständige Offline-Lokalisierung — komplette Übersetzung über alle Ansichten, Registerkarten, Dialoge, Timer, Stoppuhr, Einstellungen, Versionshinweise und Klingelansicht in 11 Sprachen</string>
    <string name="rel_v1_6_4_item2">Prioritäre Sprachauswahl beim Start — Dialog wird sofort vor den Systemberechtigungen angezeigt</string>
    <string name="rel_v1_6_4_item3">Einheitliche Standardziffern — Zahlen bleiben in allen Übersetzungen strikt 1, 2, 3 für optimale Lesbarkeit</string>

    <!-- Release Notes Items v1.6.3 -->
    <string name="rel_v1_6_3_item1">Mehrsprachige Grundlage — Sprachwähler in der App und 11 Offline-Sprachpakete</string>
    <string name="rel_v1_6_3_item2">Ersteinrichtungs-Dialog — bevorzugte Sprache und Design direkt bei der Installation wählen</string>
    <string name="rel_v1_6_3_item3">In-App-Spracheinstellungen — Anzeige-Sprache jederzeit flexibel in den Einstellungen anpassen</string>

    <!-- Release Notes Items v1.6.2 -->
    <string name="rel_v1_6_2_item1">Android 9-Kompatibilität — Behebung unerwarteter Schließungen auf Android 9 und älteren Versionen</string>
    <string name="rel_v1_6_2_item2">Hintergrunddienst-Schutz — abgesicherte Vordergrundbenachrichtigungen für unterbrechungsfreie Zeitmessung</string>
    <string name="rel_v1_6_2_item3">Sofortiger Timer-Alarmstopp — Tippen auf Löschen oder Zurücksetzen beendet den Klingelton sofort</string>
    <string name="rel_v1_6_2_item4">Intelligente Benachrichtigungsnavigation — Titel zeigt Timer oder Stoppuhr und öffnet die aktive Registerkarte</string>
    <string name="rel_v1_6_2_item5">Sicherer Alarmlebenszyklus — sofortiges Schließen und Rückkehr zum Sperrbildschirm</string>

    <!-- Release Notes Items v1.6.1 -->
    <string name="rel_v1_6_1_item1">F-Droid-Konformität — saubere Open-Source-Metadaten, Apache-2.0-Lizenz, ohne Netzwerk-Prüfungen</string>
    <string name="rel_v1_6_1_item2">Berechtigungsübersicht — vereinfachte Schnittstelle für Systemberechtigungen</string>

    <!-- Release Notes Items v1.6 -->
    <string name="rel_v1_6_item1">Dauerhafte Hintergrundbenachrichtigung — Benachrichtigung kann während des Laufs nicht weggewischt werden, mit \'Alles stoppen\'-Button</string>
    <string name="rel_v1_6_item2">Kontrast im Hell-Modus — Weckzeiten mit kräftigen, kontrastreichen Farben</string>
    <string name="rel_v1_6_item3">Abgestimmte Tönung im Hell-Modus — grau-blauer Hintergrund für effektivere Helligkeitsregelung</string>

    <!-- Release Notes Items v1.5 -->
    <string name="rel_v1_5_item1">Gespeicherter Lieblingstitel — zuletzt gewählte Musikdatei wird automatisch für neue Alarme übernommen</string>
    <string name="rel_v1_5_item2">Mehrere Timer — bis zu 5 unabhängige Countdown-Timer gleichzeitig ausführen</string>
    <string name="rel_v1_5_item3">Pure Dark-Modus — echtes AMOLED-Schwarz für maximale Energieeinsparung auf OLED-Displays</string>
    <string name="rel_v1_5_item4">Helligkeitsregler im Hell-Modus — Hintergrund von getönt bis reinweiß stufenlos anpassen</string>
    <string name="rel_v1_5_item5">Hintergrund-Timer &amp; Stoppuhr — laufen dank Vordergrunddienst zuverlässig weiter</string>
    <string name="rel_v1_5_item6">Klingeln bei Stumm &amp; Nicht stören — Alarme umgehen die Ruftonlautstärke</string>

    <!-- Release Notes Items v1.4 -->
    <string name="rel_v1_4_item1">Offizieller Paketname — aktualisiert auf com.beemasfincon.cyclicalarms</string>
    <string name="rel_v1_4_item2">Zuverlässigkeitsverbesserungen — optimierte Weckzeitplanung und Lifecycle-Verwaltung</string>

    <!-- Release Notes Items v1.3 -->
    <string name="rel_v1_3_item1">Timer — Countdown mit Fortschrittsring, Schnellwahltasten (1m–30m) und Ton-/Vibrationsalarm</string>
    <string name="rel_v1_3_item2">Stoppuhr — Zeitmessung mit Runden, Hervorhebung der schnellsten/langsamsten Runden und Tastentönen</string>
    <string name="rel_v1_3_item3">Strikte Sperrbildschirm-Privatsphäre — Anzeige über der Bildschirmsperre nur bei aktivem Klingeln</string>
    <string name="rel_v1_3_item4">Navigation mit 4 Registerkarten — Alarme, Timer, Stoppuhr, Einstellungen mit Über-Seite</string>
    <string name="rel_v1_3_item5">Zyklisch als Standard — neue Alarme öffnen direkt die Registerkarte Zyklische Tage</string>
    <string name="rel_v1_3_item6">Symbolanpassung — App-Icon wird auf dem Launcher nicht mehr beschnitten dargestellt</string>

    <!-- Release Notes Items v1.2 -->
    <string name="rel_v1_2_item1">Spiral-Skizzen-Symbol — symmetrischer Bleistiftskizzen-Wecker als App-Icon</string>
    <string name="rel_v1_2_item2">Individuelle Schlummerdauer — Schlummerzeit für jeden Wecker separat festlegen</string>
    <string name="rel_v1_2_item3">Natives Klingeln auf Sperrbildschirm — saubere Alarmierung ohne vorherige PIN-Eingabe</string>
    <string name="rel_v1_2_item4">Strukturierte Navigation — übersichtliches 4-Reiter-Layout</string>
    <string name="rel_v1_2_item5">12h / 24h Uhrzeitformat — wählen Sie Ihr bevorzugtes Format mit AM/PM</string>
    <string name="rel_v1_2_item6">Jahresanzeige im Datum — Startbildschirm zeigt das vollständige Jahr (z.B. Sa, 5. Sep 2026)</string>
    <string name="rel_v1_2_item7">Designauswahl beim ersten Start — optimale Sichtbarkeit der Statusleistensymbole</string>
    <string name="rel_v1_2_item8">In-App-Berechtigungsmanager — direkte Kontrolle aller wichtigen Systemzugriffe</string>
    <string name="rel_v1_2_item9">Support &amp; Community-Karte — direkter Draht für Feedback und Fehlerberichte</string>

    <!-- Release Notes Items v1.1 -->
    <string name="rel_v1_1_item1">Dunkel / Hell / System-Design in den Einstellungen</string>
    <string name="rel_v1_1_item2">Weckereditor startet mit der aktuellen Uhrzeit</string>
    <string name="rel_v1_1_item3">Minutenauswahl dauerhaft sichtbar</string>
    <string name="rel_v1_1_item4">Neuer hoher Alarmton — lauter Zweiton-Weckruf</string>
    <string name="rel_v1_1_item5">Standardlautstärke für neue Wecker auf Maximum</string>
    <string name="rel_v1_1_item6">Beema\'s FINCON-Signatur auf dem Startbildschirm</string>

    <!-- Release Notes Items v1.0 -->
    <string name="rel_v1_0_item1">Zyklische Alarme — Wecken alle N Tage ab einem Startdatum</string>
    <string name="rel_v1_0_item2">Wöchentliche Alarme — beliebige Wochentage frei kombinierbar</string>
    <string name="rel_v1_0_item3">7 integrierte Synthesizer-Sounds und Unterstützung eigener Audiodateien</string>
    <string name="rel_v1_0_item4">Einstellbares Schlummern und Vibration</string>
    <string name="rel_v1_0_item5">Alarmverlauf mit Löschfunktion</string>
