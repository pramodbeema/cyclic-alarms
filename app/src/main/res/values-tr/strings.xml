    <!-- Release Notes Items v1.7 -->
    <string name="rel_v1_7_item1">Canlı Erteleme Bildirimi — canlı geri sayım, tam erteleme zamanı ve süresi ile hızlı kapatma</string>
    <string name="rel_v1_7_item2">Gelişmiş Çalma Ekranı — tam ekranda geçerli saat ve alarmın ne zaman ertelendiği bilgisi</string>

    <!-- Release Notes Items v1.6.5 -->
    <string name="rel_v1_6_5_item1">Tek Seferlik Alarm Düzeltmesi — tek seferlik alarmlar artık çaldıktan ve kapatıldıktan sonra otomatik olarak devre dışı kalır, istenmeyen günlük tekrarlar önlenir</string>

    <!-- Release Notes Items v1.6.4 -->
    <string name="rel_v1_6_4_item1">Kapsamlı Çevrimdışı Yerelleştirme — tüm ekranlar, sekmeler, iletişim pencereleri, sayaçlar, kronometre, ayarlar, sürüm notları ve çalma arayüzü 11 dilde eksiksiz çevrildi</string>
    <string name="rel_v1_6_4_item2">İlk Açılışta Öncelikli Dil Seçimi — dil seçici penceresi sistem izinlerinden önce doğrudan gösterilir</string>
    <string name="rel_v1_6_4_item3">Evrensel Standart Rakamlar — sayılar net ve kolay okunabilirlik için kesinlikle 1, 2, 3 olarak korunur</string>

    <!-- Release Notes Items v1.6.3 -->
    <string name="rel_v1_6_3_item1">Çok Dilli Destek Temeli — uygulama içi dil seçici ve 11 çevrimdışı dil paketi</string>
    <string name="rel_v1_6_3_item2">İlk Kurulum Diyaloğu — ilk açılışta tercih edilen dil ve temayı seçme imkanı</string>
    <string name="rel_v1_6_3_item3">Uygulama İçi Dil Ayarları — Ayarlar sayfasından ekran dilini dilediğiniz an değiştirme</string>

    <!-- Release Notes Items v1.6.2 -->
    <string name="rel_v1_6_2_item1">Android 9 Uyumluluk Düzeltmesi — Android 9 ve eski sürümlerdeki ani kapanmalar giderildi</string>
    <string name="rel_v1_6_2_item2">Ön Plan Servisi Koruması — arka planda kesintisiz sayaç takibi sağlandı</string>
    <string name="rel_v1_6_2_item3">Sayaç Uyarısını Anında Susturma — Temizle veya Sıfırla ses çalmayı anında durdurur</string>
    <string name="rel_v1_6_2_item4">Akıllı Bildirim Yönlendirmesi — bildirim başlığı Sayaç/Kronometre durumunu gösterir ve ilgili sekmeyi açar</string>
    <string name="rel_v1_6_2_item5">Temiz Alarm Döngüsü — arka plana sızmadan anında kapatma ve kilit ekranına dönüş</string>

    <!-- Release Notes Items v1.6.1 -->
    <string name="rel_v1_6_1_item1">F-Droid Uyumluluğu — temiz açık kaynak meta verileri, Apache-2.0 lisansı, ağ denetleyicisi kaldırıldı</string>
    <string name="rel_v1_6_1_item2">İzin Akışı Sadeleştirmesi — modern ve eski Android sürümleri için basitleştirilmiş izin yönetimi</string>

    <!-- Release Notes Items v1.6 -->
    <string name="rel_v1_6_item1">Kapatılamayan Arka Plan Bildirimi — sayaç ve kronometre çalışırken bildirim kaydırılamaz, \'Tümünü Durdur\' butonu eklendi</string>
    <string name="rel_v1_6_item2">Açık Mod Alarm Saati Kontrastı — alarm saatleri için yüksek kontrastlı net renkler</string>
    <string name="rel_v1_6_item3">Açık Mod Arka Plan Dengesi — parlaklık kaydırıcısının daha işlevsel olması için ideal zemin tonu</string>

    <!-- Release Notes Items v1.5 -->
    <string name="rel_v1_5_item1">Kalıcı Özel Parça — en son seçilen müzik dosyası yeni alarmlara otomatik uygulanır</string>
    <string name="rel_v1_5_item2">Çoklu Sayaçlar — aynı anda 5 adede kadar bağımsız geri sayım sayacı çalıştırın</string>
    <string name="rel_v1_5_item3">Pure Dark Modu — OLED ekranlarda pil tasarrufu sağlayan gerçek AMOLED siyah tema</string>
    <string name="rel_v1_5_item4">Açık Mod Parlaklık Ayarı — arka planı griden saf beyaza kadar ayarlayın</string>
    <string name="rel_v1_5_item5">Arka Plan Sayaç ve Kronometre — uygulama arka plandayken ön plan servisiyle çalışmaya devam eder</string>
    <string name="rel_v1_5_item6">Sessiz ve Rahatsız Etmeyin Modunda Çalar — alarmlar zil sesi seviyesini aşarak mutlaka çalar</string>

    <!-- Release Notes Items v1.4 -->
    <string name="rel_v1_4_item1">Resmi Paket Adı — paket kimliği com.beemasfincon.cyclicalarms olarak güncellendi</string>
    <string name="rel_v1_4_item2">Güvenilirlik İyileştirmeleri — alarm zamanlama ve servis yaşam döngüsü güçlendirildi</string>

    <!-- Release Notes Items v1.3 -->
    <string name="rel_v1_3_item1">Sayaç — ilerleme halkalı geri sayım sayacı, hızlı ön ayarlar (1dk–30dk), ses ve titreşim uyarısı</string>
    <string name="rel_v1_3_item2">Kronometre — tur kayıtlı zaman takibi, en hızlı/yavaş tur vurguları ve sesli dokunma geri bildirimi</string>
    <string name="rel_v1_3_item3">Sıkı Kilit Ekranı Gizliliği — kilit ekranı üzerinde yalnızca alarm aktif çalarken görünür</string>
    <string name="rel_v1_3_item4">4 Sekmeli Gezinme — Alarmlar, Sayaç, Kronometre ve Hakkında sayfası içeren Ayarlar</string>
    <string name="rel_v1_3_item5">Varsayılan Döngüsel Sekme — yeni alarmlar doğrudan Döngüsel Günler sekmesinde açılır</string>
    <string name="rel_v1_3_item6">Simge Uyumluluğu — uygulama simgesi başlatıcıda tam ve düzgün görünür</string>

    <!-- Release Notes Items v1.2 -->
    <string name="rel_v1_2_item1">Spiral Çizim Simgesi — simetrik kalem çizimi çalar saat başlatıcı simgesi</string>
    <string name="rel_v1_2_item2">Her Alarma Özel Erteleme — her alarm için ayrı erteleme süresi belirleme</string>
    <string name="rel_v1_2_item3">Yerel Kilit Ekranı Çalma — kilit üzerinde PIN istemeden doğrudan çalar</string>
    <string name="rel_v1_2_item4">Özel Sayfa Düzeni — 4 sekmeli temiz arayüz</string>
    <string name="rel_v1_2_item5">12S / 24S Saat Formatı — büyük harfli AM/PM veya 24 saat seçeneği</string>
    <string name="rel_v1_2_item6">Tarihte Yıl Gösterimi — ana ekranda tam yıl gösterimi (örn. Cts, 5 Eyl 2026)</string>
    <string name="rel_v1_2_item7">İlk Açılış Tema Uyarısı — durum çubuğu simgelerinin kusursuz görünürlüğü</string>
    <string name="rel_v1_2_item8">Uygulama İçi İzin Yöneticisi — bildirim, kesin alarm ve pencere izinlerini yönetme</string>
    <string name="rel_v1_2_item9">Destek ve Topluluk Kartı — geri bildirim ve hata bildirimi için doğrudan iletişim</string>

